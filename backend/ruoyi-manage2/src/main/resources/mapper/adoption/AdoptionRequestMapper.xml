<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.adoption.mapper.AdoptionRequestMapper">
    
    <resultMap type="AdoptionRequest" id="AdoptionRequestResult">
        <result property="requestId"    column="request_id"    />
        <result property="petId"    column="pet_id"    />
        <result property="userId"    column="user_id"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="reviewRemark"    column="review_remark"    />
        <result property="reviewTime"    column="review_time"    />
        <result property="reviewBy"    column="review_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="petName" column="pet_name"    />
    </resultMap>

    <sql id="selectAdoptionRequestVo">
        select request_id, pet_id, user_id, reason, status, review_remark, review_time, review_by, create_time from tb_adoption_request
    </sql>

    <select id="selectAdoptionRequestList" parameterType="AdoptionRequest" resultMap="AdoptionRequestResult">
        select
        ar.request_id, ar.pet_id, ar.user_id, ar.reason, ar.status,
        ar.review_remark, ar.review_time, ar.review_by, ar.create_time,
        p.name as pet_name
        from tb_adoption_request ar
        left join tb_pet p on ar.pet_id = p.pet_id
        <where>
            <if test="petId != null "> and ar.pet_id = #{petId}</if>
            <if test="userId != null "> and ar.user_id = #{userId}</if>
            <if test="reason != null  and reason != ''"> and ar.reason like concat('%', #{reason}, '%')</if>
            <if test="status != null  and status != ''"> and ar.status = #{status}</if>
            <if test="reviewRemark != null  and reviewRemark != ''"> and ar.review_remark like concat('%', #{reviewRemark}, '%')</if>
            <if test="reviewTime != null "> and date(ar.review_time) = date(#{reviewTime})</if>
            <if test="reviewBy != null  and reviewBy != ''"> and ar.review_by like concat('%', #{reviewBy}, '%')</if>
        </where>
    </select>

    <select id="selectAdoptionRequestByRequestId" parameterType="Long" resultMap="AdoptionRequestResult">
        select
            ar.request_id, ar.pet_id, ar.user_id, ar.reason, ar.status,
            ar.review_remark, ar.review_time, ar.review_by, ar.create_time,
            p.name as pet_name
        from tb_adoption_request ar
                 left join tb_pet p on ar.pet_id = p.pet_id
        where ar.request_id = #{requestId}
    </select>

    <select id="selectPendingRequestByPetId" parameterType="Long" resultMap="AdoptionRequestResult">
        <include refid="selectAdoptionRequestVo"/>
        where pet_id = #{petId} and status = 'pending'
        order by create_time desc
        limit 1
    </select>

    <select id="selectPendingRequestByPetIdExclude" resultMap="AdoptionRequestResult">
        <include refid="selectAdoptionRequestVo"/>
        where pet_id = #{petId} and status = 'pending' and request_id != #{excludeRequestId}
        order by create_time desc
        limit 1
    </select>

    <insert id="insertAdoptionRequest" parameterType="AdoptionRequest" useGeneratedKeys="true" keyProperty="requestId">
        insert into tb_adoption_request
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="petId != null">pet_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="reason != null">reason,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="reviewRemark != null">review_remark,</if>
            <if test="reviewTime != null">review_time,</if>
            <if test="reviewBy != null">review_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="petId != null">#{petId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="reason != null">#{reason},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="reviewRemark != null">#{reviewRemark},</if>
            <if test="reviewTime != null">#{reviewTime},</if>
            <if test="reviewBy != null">#{reviewBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateAdoptionRequest" parameterType="AdoptionRequest">
        update tb_adoption_request
        <trim prefix="SET" suffixOverrides=",">
            <if test="petId != null">pet_id = #{petId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reviewRemark != null">review_remark = #{reviewRemark},</if>
            <if test="reviewTime != null">review_time = #{reviewTime},</if>
            <if test="reviewBy != null">review_by = #{reviewBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where request_id = #{requestId}
    </update>

    <delete id="deleteAdoptionRequestByRequestId" parameterType="Long">
        delete from tb_adoption_request where request_id = #{requestId}
    </delete>

    <delete id="deleteAdoptionRequestByRequestIds" parameterType="String">
        delete from tb_adoption_request where request_id in 
        <foreach item="requestId" collection="array" open="(" separator="," close=")">
            #{requestId}
        </foreach>
    </delete>
</mapper>